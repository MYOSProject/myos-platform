# ---- IA (Gemini) ----
GEMINI_API_KEY=
# Opcional: cadena de modelos separados por coma
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite

# ---- Sesión y aprobación ----
# Correos que pueden aprobar/publicar (si está vacío, cualquier usuario con correo verificado)
APPROVER_EMAILS=
# Solo desarrollo local: AUTH_MODE=dev permite entrar con un correo de prueba (se ignora en producción)
# AUTH_MODE=dev

# ---- Publicación en redes (sin esto, todo queda en modo simulación) ----
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=
# o directo a Meta Graph API:
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=

# ---- Otros ----
PUBLIC_BASE_URL=
# DATA_FILE=data/db.json
