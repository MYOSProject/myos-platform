# ---- IA (Gemini) ----
GEMINI_API_KEY=
# Opcional: cadena de modelos separados por coma
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# ---- Sesión y aprobación ----
# Por defecto CUALQUIER usuario con sesión puede aprobar y publicar (se registra quién).
# Para limitarlo: RESTRICT_APPROVERS=true y lista APPROVER_EMAILS.
# RESTRICT_APPROVERS=true
APPROVER_EMAILS=
# Solo desarrollo local: AUTH_MODE=dev permite entrar con un correo de prueba (se ignora en producción)
# AUTH_MODE=dev

# ---- Publicación en redes (sin esto, todo queda en modo simulación) ----
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=
# o directo a Meta Graph API:
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=

# ---- Otros ----
PUBLIC_BASE_URL=
# DATA_FILE=data/db.json

# ---- Persistencia en Vercel (Firestore) ----
# JSON de la cuenta de servicio (o en base64). Sin esto, Vercel pierde los datos al reiniciar.
FIREBASE_SERVICE_ACCOUNT=
# Id de la base (viene en firebase-applet-config.json); por defecto (default)
# FIRESTORE_DATABASE_ID=
# Clave para cifrar los tokens de Meta por proyecto (obligatoria en producción). Ej.: openssl rand -hex 32
CONNECTIONS_KEY=
