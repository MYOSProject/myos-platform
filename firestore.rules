rules_version = '2';
// MYOS: el flujo de aprobación vive en el servidor (Express + auditoría + huella SHA-256).
// Firestore queda cerrado a clientes: nadie puede crear contenido APPROVED ni borrar desde el navegador.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email', 'name', 'photoURL', 'updated_at'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 256;
      allow delete: if false;
    }
  }
}
